IF
  INI("DMWW_fiend_difficulty",0)
  Global("inafight","LOCALS",0)
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    SetGlobal("inafight","LOCALS",1)
    Continue()
END

IF
  HPPercentLT(Myself,30)
  !Global("escaped","LOCALS",1)
THEN
  RESPONSE #100
    DropInventory()
    SpellNoDecRES("b-hkgon",Myself)
  RESPONSE #100
    Continue()
END

IF
  HPLT(Myself,20)
  OR(3)
    See(NearestEnemyOf(Myself))
    Heard([ANYONE],99)
THEN
  RESPONSE #100
    ReallyForceSpellRES("b-hkgon",Myself)
END

IF
  !GlobalTimerNotExpired("castspell","LOCALS")
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    SetGlobalTimer("castspell","LOCALS",6)
    AttackReevaluate(NearestEnemyOf(Myself),30)
END

IF
  See(NearestEnemyOf(Myself))
  HPPercentLT(Myself,25)
THEN
  RESPONSE #100
    ForceSpellRES("b-hkgon",Myself)
END

IF
  HPPercentLT(Myself,15)
  !HPPercentLT(Myself,0)
  Range(NearestEnemyOf(Myself),10)
  Global("GateAway","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("GateAway","LOCALS",1)
    SetGlobalTimer("Running","LOCALS",2)
    CreateVisualEffectObject("SPSUMGTE",Myself)
    SmallWait(8)
    DisplayStringHead(Myself,2)
    DestroySelf()
END

IF
  HPLT(Myself,30)
  Global("scene","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("scene","LOCALS",1)
    StartCutSceneMode()
    SetGlobal("SPRITE_IS_DEADbhkext","GLOBAL",1)
    EndCutSceneMode()
    DestroySelf()
END

IF
  HPPercentLT(Myself,20)
THEN
  RESPONSE #100
    SetGlobal("bhkfled","GLOBAL",1)
    ForceSpellRES("b-hkgon",Myself)
END

IF
  OR(2)
    HPLT(Myself,5)
    Die()
THEN
  RESPONSE #100
    DestroySelf()
END

IF
  HPPercentLT(Myself,50)
THEN
  RESPONSE #100
    ForceSpellRES("b-hkheal",Myself)
END

