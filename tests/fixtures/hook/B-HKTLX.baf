IF
  See([PC])
  NumTimesTalkedTo(0)
THEN
  RESPONSE #100
    Dialog([PC])
END

IF
  INI("DMWW_genai_difficulty",0)
  NumTimesTalkedTo(0)
  See(Player1)
THEN
  RESPONSE #100
    Dialog(Player1)
END

IF
  NumTimesTalkedTo(0)
  See([PC])
THEN
  RESPONSE #100
    Enemy()
END

IF
  NumTimesTalkedToGT(0)
  See([PC])
THEN
  RESPONSE #100
    Dialog([PC])
END
