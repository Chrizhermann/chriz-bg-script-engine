{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chriz-bg-script-engine/install-manifest.schema.json",
  "$comment": "Provisional Task 5 host-only shape contract. The stdlib tests validate only the keywords used here, not a full JSON Schema conformance implementation. Identity uniqueness, digest authenticity, declaration closure, and deterministic ordering are checked by the prototype, not this schema. No runtime ownership or complete real-game scan is implied.",
  "title": "Synthetic install inventory prototype",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "stackId", "runtimeActivation", "resources", "inventoryDigest"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "profile": {"type": "string", "const": "synthetic-inventory-v1"},
    "stackId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])"},
    "runtimeActivation": {"type": "boolean", "const": false},
    "inventoryDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "byteLength", "scriptSlots", "dependencies", "publicVariables", "opaqueNodes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9_#-]{1,8}\\.(CRE|BCS|DLG|ARE|SPL|ITM|PRO|IDS|2DA)$(?![\\s\\S])"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
          "byteLength": {"type": "integer", "minimum": 0},
          "scriptSlots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "slot", "target"],
              "properties": {
                "position": {"type": "integer", "minimum": 0},
                "slot": {"type": "string", "enum": ["override", "class", "race", "general", "default", "area"]},
                "target": {"type": ["string", "null"], "pattern": "^[A-Z0-9_#-]{1,8}\\.(CRE|BCS|DLG|ARE|SPL|ITM|PRO|IDS|2DA)$(?![\\s\\S])"}
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "kind", "target"],
              "properties": {
                "position": {"type": "integer", "minimum": 0},
                "kind": {"type": "string", "enum": ["declared", "script-slot"]},
                "target": {"type": "string", "pattern": "^[A-Z0-9_#-]{1,8}\\.(CRE|BCS|DLG|ARE|SPL|ITM|PRO|IDS|2DA)$(?![\\s\\S])"}
              }
            }
          },
          "publicVariables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "scope", "name", "access"],
              "properties": {
                "position": {"type": "integer", "minimum": 0},
                "scope": {"type": "string", "const": "GLOBAL"},
                "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$(?![\\s\\S])"},
                "access": {"type": "string", "enum": ["read", "write"]}
              }
            }
          },
          "opaqueNodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "reason"],
              "properties": {
                "position": {"type": "integer", "minimum": -1},
                "reason": {"type": "string", "enum": ["unsupported-format", "malformed-document", "unknown-node", "invalid-node", "duplicate-slot"]}
              }
            }
          }
        }
      }
    }
  }
}
