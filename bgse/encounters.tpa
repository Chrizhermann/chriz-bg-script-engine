// The designed encounters: what each fight's design changes in its creatures, one entry each, in story
// order (bgse/lib/encounter.tpa: bgse_encounter). The design is
// docs/research/BOSS-01-bg1-early-encounters.md; the engine's side of it is combat-intent/encounters.lua.
// Each entry adds what it changed to bgse_designed.

// 2. Silke, Beregost (Christopher, 2026-11-03 and 2026-11-04): she plans the ambush herself, so when her
// "thugs" arrive she drinks her Potion of Invulnerability and casts Mirror Image in sight of the party,
// before it chooses. Garrick warns of her songs at the end of his offer, before the party meets her.
LAF bgse_encounter
  STR_VAR cre = ~silke~
          cutscene = ~SILKECUT~
          prepare = ~POTN11 SPWI212~
  RET bgse_changed END
OUTER_SET bgse_designed += bgse_changed
LAF bgse_encounter_line
  STR_VAR dlg = ~garric~
          after = ~StartCutSceneEx("Garrcut"~
          state = ~bgse_silke_song~
          line = ~And when she sings, folks forget their own minds. Best stay on her good side!~
  RET bgse_said END
OUTER_SET bgse_lines += bgse_said

// 3. Karlat, Red Sheaf, Beregost (Christopher, 2026-11-04): his own copy of the game's talk script INITDLG,
// which many creatures share, so that only his talk waits while he drinks his battle potion before he speaks.
LAF bgse_encounter
  STR_VAR cre = ~karlat~
          talk = ~INITDLG>BGSEKARL~
  RET bgse_changed END
OUTER_SET bgse_designed += bgse_changed

// 4. Neira, Nashkel Inn (Christopher, 2026-11-04): WIS 15, which gives her five, four and one priest
// spells at level 5; her book (Remove Fear goes, no Draw Upon Holy Might); a Potion of Invisibility for her
// opener.
LAF bgse_encounter INT_VAR wis = 15
  STR_VAR cre = ~neira~
          book = ~priest1=SPPR111,SPPR117,SPPR113,SPPR102,SPPR101 priest2=SPPR201,SPPR208,SPPR211,SPPR213 priest3=SPPR314~
          carries = ~POTN10~
  RET bgse_changed END
OUTER_SET bgse_designed += bgse_changed
