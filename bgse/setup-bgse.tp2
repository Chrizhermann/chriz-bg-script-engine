BACKUP ~bgse/backup~
AUTHOR ~Christopher (Chris)~
VERSION ~0.1.0-dev~

// Chriz BG Script Engine builds on Sword Coast Stratagems by David Wallace (DavidW) and on
// Spell Revisions by Demivrgvs and the Gibberlings Three. It reads the scripts SCS generated
// in this game; it ships no SCS files.

BEGIN ~Chriz BG Script Engine: let the engine take over SCS creatures' rounds (experimental, needs EEex)~
  DESIGNATED 0
  LABEL ~bgse-hook~

REQUIRE_PREDICATE (FILE_EXISTS ~override/M___EEex.lua~)
  ~EEex is not installed.~
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~TRIGGER~ ~EEex_LuaTrigger~) = 0x410E)
  ~TRIGGER.IDS lacks EEex_LuaTrigger (0x410E).~
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~ACTION~ ~EEex_LuaAction~) = 472)
  ~ACTION.IDS lacks EEex_LuaAction (472).~

INCLUDE ~bgse/lib/hook.tpa~
INCLUDE ~bgse/lib/encounter.tpa~

COPY ~bgse/lua/M_BGSE.lua~ ~override~

OUTER_SET bgse_hooked = 0
OUTER_SET bgse_copied = 0
OUTER_SET bgse_aside = 0
OUTER_SET bgse_hunted = 0
OUTER_SET bgse_jumped = 0
OUTER_SET bgse_skipped = 0
OUTER_TEXT_SPRINT bgse_registry ~~
// The spells known to move their caster, those looked up so far, and the hooked scripts that
// teleport their creature by script (bgse/lib/hook.tpa).
OUTER_TEXT_SPRINT bgse_teleports ~|~
OUTER_TEXT_SPRINT bgse_checked ~|~
OUTER_TEXT_SPRINT bgse_teleporters ~|~
// The spells known to make their target invisible, those of Improved Invisibility, those whose files
// say innate, those looked up so far, the hooked scripts that make their creature invisible for free
// and the real abilities that stand in for that, by script (bgse/lib/hook.tpa). SCS's timers may name
// the game's timer lengths (GTIMES.IDS).
OUTER_TEXT_SPRINT bgse_invisible ~|~
OUTER_TEXT_SPRINT bgse_improved ~|~
OUTER_TEXT_SPRINT bgse_innate ~|~
OUTER_TEXT_SPRINT bgse_looked ~|~
OUTER_TEXT_SPRINT bgse_hiders ~|~
OUTER_TEXT_SPRINT bgse_gifts_of ~|~
OUTER_SET bgse_hidden = 0
// SCS's preparation blocks (prebuffs, contingencies, chains, first-round casts) that ask the engine.
OUTER_SET bgse_prepared = 0
// The spells known to remove their target from the game, and SCS's vanishing exits that yield while
// the engine keeps the creature in the fight (Christopher, 2026-10-28: nobody leaves for good).
OUTER_TEXT_SPRINT bgse_vanish ~|~
OUTER_SET bgse_kept = 0
// SCS's talk-on-sight blocks that wait while the engine prepares the creature (Christopher, 2026-11-03).
OUTER_SET bgse_talked = 0
LAF bgse_times_list RET bgse_times END
ACTION_BASH_FOR ~override~ ~^.+\.bcs$~ BEGIN
  COPY_EXISTING ~%BASH_FOR_FILE%~ ~override~
    // SCS scripts carry its castspell round timer and its DMWW_ difficulty settings.
    PATCH_IF (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~castspell~) >= 0)
         AND (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~DMWW_~) >= 0) BEGIN
      TEXT_SPRINT bgse_script ~%BASH_FOR_RES%~
      TO_LOWER bgse_script
      LPF bgse_hook_bcs STR_VAR bgse_script = EVAL ~%bgse_script%~ bgse_teleports = EVAL ~%bgse_teleports%~
          bgse_checked = EVAL ~%bgse_checked%~ bgse_invisible = EVAL ~%bgse_invisible%~
          bgse_improved = EVAL ~%bgse_improved%~ bgse_innate = EVAL ~%bgse_innate%~ bgse_vanish = EVAL ~%bgse_vanish%~
          bgse_looked = EVAL ~%bgse_looked%~ bgse_times = EVAL ~%bgse_times%~
        RET bgse_result bgse_family bgse_copies bgse_clouds bgse_hunts bgse_jumps bgse_hides bgse_preps bgse_exits bgse_teleporter
            bgse_hider bgse_gifts bgse_teleports bgse_checked bgse_invisible bgse_improved bgse_innate bgse_vanish bgse_looked END
      PATCH_IF (~%bgse_result%~ STRING_EQUAL_CASE ~hooked~) BEGIN
        SET bgse_hooked += 1
        SET bgse_copied += bgse_copies
        SET bgse_aside += bgse_clouds
        SET bgse_hunted += bgse_hunts
        SET bgse_jumped += bgse_jumps
        SET bgse_hidden += bgse_hides
        SET bgse_prepared += bgse_preps
        SET bgse_kept += bgse_exits
        TEXT_SPRINT bgse_registry ~%bgse_registry%  ['%bgse_script%']='%bgse_family%',%LNL%~
        PATCH_IF (bgse_teleporter = 1) BEGIN
          TEXT_SPRINT bgse_teleporters ~%bgse_teleporters%%bgse_script%|~
        END
        PATCH_IF (bgse_hider = 1) BEGIN
          TEXT_SPRINT bgse_hiders ~%bgse_hiders%%bgse_script%|~
        END
        INNER_PATCH ~%bgse_gifts%~ BEGIN
          REPLACE_EVALUATE CASE_SENSITIVE ~\([RI]:[^|]+\)~ BEGIN
            TEXT_SPRINT bgse_gifts_of ~%bgse_gifts_of%%bgse_script%>%MATCH1%|~
          END ~%MATCH0%~
        END
        PATCH_LOG ~BGSE hook: %BASH_FOR_RES% (%bgse_family%, %bgse_copies% guarded SCS blocks, %bgse_clouds% SCS cloud blocks, %bgse_hunts% SCS hunting blocks, %bgse_jumps% SCS jumps, %bgse_hides% SCS free invisibility blocks, %bgse_preps% SCS preparation blocks, %bgse_exits% SCS vanishing exits)~
      END ELSE PATCH_IF NOT (~%bgse_result%~ STRING_EQUAL_CASE ~not-scs~) BEGIN
        SET bgse_skipped += 1
        PATCH_PRINT ~BGSE hook: left %BASH_FOR_RES% as it is (%bgse_result%)~
      END
    // SCS's talk-on-sight script (its DMWW_ marker, no castspell round timer): its talk blocks wait while the
    // engine prepares the creature (bgse/lib/hook.tpa: bgse_talk_bcs).
    END ELSE PATCH_IF (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~DMWW_~) >= 0)
        AND (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~BGSE_TalkHold~) < 0) BEGIN
      TEXT_SPRINT bgse_script ~%BASH_FOR_RES%~
      TO_LOWER bgse_script
      LPF bgse_talk_bcs STR_VAR bgse_script = EVAL ~%bgse_script%~ RET bgse_talks END
      PATCH_IF (bgse_talks > 0) BEGIN
        SET bgse_talked += bgse_talks
        PATCH_LOG ~BGSE talk: %BASH_FOR_RES% (%bgse_talks% SCS talk-on-sight blocks)~
      END
    END
  BUT_ONLY_IF_IT_CHANGES
END
// Creatures SCS lets teleport only by script get a real innate teleport, which the engine casts
// like any spell (Christopher, 2026-10-26); one with a teleport of its own (most fiends have the
// game's Teleport Without Error) keeps that one. Thieves SCS makes invisible for free hide with
// their own Hide in Shadows instead, and get hide skills that fit their level (Christopher,
// 2026-10-26). Every creature SCS makes invisible for free gets real innate abilities for that, as
// often as SCS gives it (Christopher, 2026-10-27), but a thief no plain invisibility.
OUTER_SET bgse_granted = 0
OUTER_SET bgse_skilled = 0
OUTER_SET bgse_gifted = 0
OUTER_SET bgse_made = 0
OUTER_TEXT_SPRINT bgse_copies ~|~
ACTION_IF (STRING_LENGTH ~%bgse_teleporters%~ > 1) OR (STRING_LENGTH ~%bgse_hiders%~ > 1) BEGIN
  LAF bgse_skill_tables RET bgse_points bgse_kits bgse_party END
  COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
    // Only a creature with one of those scripts changes, so the others are not looked at further.
    SET bgse_named = 0
    PATCH_IF (BUFFER_LENGTH >= 0x2d4) BEGIN
      READ_ASCII 0 signature (8)
      PATCH_IF (~%signature%~ STRING_EQUAL ~CRE V1.0~) BEGIN
        FOR (o = 0x248; o < 0x270; o += 8) BEGIN
          READ_ASCII o script (8) NULL
          TO_LOWER script
          PATCH_IF (STRING_LENGTH ~%script%~ > 0) AND ((INDEX (CASE_SENSITIVE EXACT_MATCH ~|%script%|~ ~%bgse_teleporters%~) >= 0)
              OR (INDEX (CASE_SENSITIVE EXACT_MATCH ~|%script%|~ ~%bgse_hiders%~) >= 0)
              OR (INDEX (CASE_SENSITIVE EXACT_MATCH ~|%script%>~ ~%bgse_gifts_of%~) >= 0)) BEGIN
            SET bgse_named = 1
          END
        END
      END
    END
    PATCH_IF (bgse_named = 1) AND (STRING_LENGTH ~%bgse_teleporters%~ > 1) BEGIN
      LPF bgse_grant_teleport STR_VAR bgse_teleporters = EVAL ~%bgse_teleporters%~ bgse_teleports = EVAL ~%bgse_teleports%~
          bgse_checked = EVAL ~%bgse_checked%~
        RET bgse_grant bgse_teleports bgse_checked END
      PATCH_IF (bgse_grant = 1) BEGIN
        SET bgse_granted += 1
        PATCH_LOG ~BGSE teleport: %SOURCE_RES% got the innate teleport~
      END
    END
    PATCH_IF (bgse_named = 1) AND (STRING_LENGTH ~%bgse_hiders%~ > 1) BEGIN
      LPF bgse_raise_skills STR_VAR bgse_hiders = EVAL ~%bgse_hiders%~ bgse_points = EVAL ~%bgse_points%~
          bgse_kits = EVAL ~%bgse_kits%~ bgse_party = EVAL ~%bgse_party%~
        RET bgse_raised END
      PATCH_IF (bgse_raised = 1) BEGIN
        SET bgse_skilled += 1
        PATCH_LOG ~BGSE hide: %SOURCE_RES% got hide skills for its level~
      END
    END
    PATCH_IF (bgse_named = 1) AND (STRING_LENGTH ~%bgse_gifts_of%~ > 1) BEGIN
      LPF bgse_grant_gifts STR_VAR bgse_gifts_of = EVAL ~%bgse_gifts_of%~ bgse_party = EVAL ~%bgse_party%~
          bgse_looked = EVAL ~%bgse_looked%~ bgse_invisible = EVAL ~%bgse_invisible%~ bgse_improved = EVAL ~%bgse_improved%~
          bgse_innate = EVAL ~%bgse_innate%~ bgse_copies = EVAL ~%bgse_copies%~
        RET bgse_given bgse_looked bgse_invisible bgse_improved bgse_innate bgse_copies END
      PATCH_IF (STRING_LENGTH ~%bgse_given%~ > 0) BEGIN
        SET bgse_gifted += 1
        PATCH_LOG ~BGSE gift: %SOURCE_RES% got %bgse_given%~
      END
    END
  BUT_ONLY_IF_IT_CHANGES
END
ACTION_IF (bgse_granted > 0) BEGIN
  LAF bgse_create_teleport END
END
ACTION_IF (STRING_LENGTH ~%bgse_copies%~ > 1) BEGIN
  LAF bgse_create_gifts STR_VAR bgse_copies = EVAL ~%bgse_copies%~ RET bgse_made END
END
// The game's own vanishing exits (Christopher, 2026-11-03: the Pirate Mage, a Hobgoblin Wizard and a Nymph stay
// in the fight; Terminsel and Lady Yuth keep their story exits): in a script that is not SCS's, an exit whose
// triggers check nothing but the creature's own hit points and what it sees waits while the engine keeps the
// creature in the fight. It asks only from above a hooked script in the creature's stack (kernel/hook.lua,
// driver), so nothing changes without one. The game's own scripts mostly sit in its archives; only those whose
// compiled form may hold such an exit are decompiled (bgse/lib/hook.tpa).
OUTER_SET bgse_stayed = 0
ACTION_IF (bgse_hooked > 0) BEGIN
  LAF bgse_exit_patterns RET bgse_hurt bgse_leave END
  ACTION_IF (STRING_LENGTH ~%bgse_hurt%~ > 0) BEGIN
    COPY_EXISTING_REGEXP GLOB ~^.+\.bcs$~ ~override~
      PATCH_IF (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~DMWW_~) < 0)
          AND (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~BGSE_Stay~) < 0) BEGIN
        LPF bgse_exit_candidate STR_VAR bgse_hurt = EVAL ~%bgse_hurt%~ bgse_leave = EVAL ~%bgse_leave%~ RET bgse_candidate END
        PATCH_IF (bgse_candidate = 1) BEGIN
          TEXT_SPRINT bgse_script ~%SOURCE_RES%~
          TO_LOWER bgse_script
          LPF bgse_own_bcs STR_VAR bgse_script = EVAL ~%bgse_script%~ bgse_invisible = EVAL ~%bgse_invisible%~
              bgse_improved = EVAL ~%bgse_improved%~ bgse_innate = EVAL ~%bgse_innate%~ bgse_vanish = EVAL ~%bgse_vanish%~
              bgse_looked = EVAL ~%bgse_looked%~
            RET bgse_exits bgse_invisible bgse_improved bgse_innate bgse_vanish bgse_looked END
          PATCH_IF (bgse_exits > 0) BEGIN
            SET bgse_stayed += bgse_exits
            PATCH_LOG ~BGSE stay: %SOURCE_RES% (%bgse_exits% vanishing exits of the game's own)~
          END
        END
      END
    BUT_ONLY_IF_IT_CHANGES
  END
END
// The designed encounters' creatures (Christopher designs each fight): ability scores, spellbooks
// and items, one entry each (bgse/encounters.tpa, bgse/lib/encounter.tpa).
OUTER_SET bgse_designed = 0
OUTER_SET bgse_lines = 0
OUTER_SET bgse_new = 0
INCLUDE ~bgse/encounters.tpa~
// The engine's own hook (2026-11-10: the engine takes over every creature, also one without an SCS script, such
// as BG1's gnolls, xvarts, ankhegs and wyverns). A script gets one hook block at its top when a creature carries
// it (a creature file's five slots, an area actor's six, the five of a creature stored in an area), it holds an
// attack or a cast (bgse/lib/hook.tpa: bgse_fight_pattern) and it does not ask the engine yet. There the engine
// is asked first in every pass, as the family the creature's class gives it ('auto'); the script's own blocks
// stay as they are, and what they do besides fighting keeps running (kernel/hook.lua, adapters/eeex/lower.lua).
// EXTEND_TOP adds the block to the compiled script without a decompile.
OUTER_SET bgse_owned = 0
<<<<<<<< .../bgse-inline/bgseown.baf
IF
  EEex_LuaTrigger("return BGSE_Claim and BGSE_Claim(EEex_LuaTrigger_Object,'auto','%bgse_script%') or false")
THEN
  RESPONSE #100
    EEex_LuaAction("if BGSE_Act then BGSE_Act(EEex_LuaAction_Object) end")
END
>>>>>>>>
LAF bgse_fight_pattern RET bgse_fight END
ACTION_IF (STRING_LENGTH ~%bgse_fight%~ > 0) BEGIN
  COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
    PATCH_IF (BUFFER_LENGTH >= 0x2d4) BEGIN
      READ_ASCII 0 signature (8)
      PATCH_IF (~%signature%~ STRING_EQUAL ~CRE V1.0~) BEGIN
        FOR (o = 0x248; o < 0x270; o += 8) BEGIN
          READ_ASCII o script (8) NULL
          TO_UPPER script
          PATCH_IF (STRING_LENGTH ~%script%~ > 0) BEGIN
            SET $bgse_carried(~%script%~) = 1
          END
        END
      END
    END
  BUT_ONLY_IF_IT_CHANGES
  COPY_EXISTING_REGEXP GLOB ~^.+\.are$~ ~override~
    PATCH_IF (BUFFER_LENGTH >= 0x5a) BEGIN
      READ_ASCII 0 signature (8)
      PATCH_IF (~%signature%~ STRING_EQUAL ~AREAV1.0~) BEGIN
        READ_LONG 0x54 actors
        READ_SHORT 0x58 actor_count
        FOR (i = 0; i < actor_count; i += 1) BEGIN
          SET actor = actors + i * 0x110
          PATCH_IF (actor >= 0) AND (actor + 0x110 <= BUFFER_LENGTH) BEGIN
            FOR (o = actor + 0x50; o < actor + 0x80; o += 8) BEGIN
              READ_ASCII o script (8) NULL
              TO_UPPER script
              PATCH_IF (STRING_LENGTH ~%script%~ > 0) BEGIN
                SET $bgse_carried(~%script%~) = 1
              END
            END
            READ_LONG (actor + 0x88) stored
            READ_LONG (actor + 0x8c) stored_size
            PATCH_IF (stored > 0) AND (stored_size >= 0x2d4) AND (stored + stored_size <= BUFFER_LENGTH) BEGIN
              READ_ASCII stored signature (8)
              PATCH_IF (~%signature%~ STRING_EQUAL ~CRE V1.0~) BEGIN
                FOR (o = stored + 0x248; o < stored + 0x270; o += 8) BEGIN
                  READ_ASCII o script (8) NULL
                  TO_UPPER script
                  PATCH_IF (STRING_LENGTH ~%script%~ > 0) BEGIN
                    SET $bgse_carried(~%script%~) = 1
                  END
                END
              END
            END
          END
        END
      END
    END
  BUT_ONLY_IF_IT_CHANGES
  ACTION_PHP_EACH bgse_carried AS bgse_name => bgse_flag BEGIN
    // A name goes into Lua text between single quotes.
    ACTION_IF (FILE_EXISTS_IN_GAME ~%bgse_name%.bcs~) AND (INDEX (CASE_SENSITIVE EXACT_MATCH ~'~ ~%bgse_name%~) < 0) BEGIN
      OUTER_SET bgse_wanted = 0
      COPY_EXISTING ~%bgse_name%.bcs~ ~override~
        PATCH_IF (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~BGSE_Claim~) < 0)
            AND (INDEX_BUFFER (CASE_SENSITIVE ~%bgse_fight%~) >= 0) BEGIN
          SET bgse_wanted = 1
        END
      BUT_ONLY_IF_IT_CHANGES
      ACTION_IF (bgse_wanted = 1) BEGIN
        OUTER_TEXT_SPRINT bgse_script ~%bgse_name%~
        ACTION_TO_LOWER bgse_script
        EXTEND_TOP ~%bgse_name%.bcs~ ~.../bgse-inline/bgseown.baf~ EVALUATE_BUFFER
        OUTER_SET bgse_owned += 1
        OUTER_TEXT_SPRINT bgse_registry ~%bgse_registry%  ['%bgse_script%']='auto',%LNL%~
      END
    END
  END
END
// The engine reads which scripts carry the hook, to tell a creature's hooked scripts from
// others in its script slots (adapters/eeex/hook.lua).
<<<<<<<< .../bgse-inline/M_BGSEHK.lua
-- Generated by the Chriz BG Script Engine installer: the scripts that carry the engine's hook, with
-- their family: SCS's scripts by SCS's kind, the game's other fight scripts as 'auto'.
BGSE_HOOKED={
%bgse_registry%}
>>>>>>>>
COPY ~.../bgse-inline/M_BGSEHK.lua~ ~override~ EVALUATE_BUFFER
PRINT ~BGSE hook: %bgse_hooked% SCS scripts hooked, %bgse_copied% SCS blocks guarded, %bgse_aside% SCS cloud blocks yield to the engine, %bgse_hunted% SCS hunting blocks yield to the engine's search, %bgse_skipped% left as they are.~
PRINT ~BGSE teleport: %bgse_jumped% SCS jumps into the fight yield to the creatures' own teleports, %bgse_granted% creatures that teleport only by script got the innate teleport BGSETELE.~
PRINT ~BGSE hide: %bgse_hidden% SCS blocks of free invisibility yield where the engine hides the creature its own way, %bgse_skilled% thieves got hide skills for their level.~
PRINT ~BGSE gift: %bgse_gifted% creatures SCS makes invisible for free got real innate abilities for it, %bgse_made% innate copies of spells made.~
PRINT ~BGSE prep: %bgse_prepared% SCS preparation blocks (prebuffs, contingencies, chains, first-round casts) ask the engine and tell it what ran.~
PRINT ~BGSE stay: %bgse_kept% SCS vanishing exits yield while the engine keeps the creature in the fight.~
PRINT ~BGSE stay: %bgse_stayed% vanishing exits in the game's own scripts yield while the engine keeps the creature in the fight.~
PRINT ~BGSE talk: %bgse_talked% SCS talk-on-sight blocks wait while the engine prepares the creature.~
PRINT ~BGSE encounter: %bgse_designed% designed creatures changed, %bgse_lines% lines added to dialogues, %bgse_new% new creatures made.~
PRINT ~BGSE own: %bgse_owned% fight scripts that are not SCS's ask the engine first.~

BEGIN ~Chriz BG Script Engine: record a playtest (experimental, needs EEex)~
  DESIGNATED 10
  LABEL ~bgse-recorder~

REQUIRE_PREDICATE (FILE_EXISTS ~override/M___EEex.lua~)
  ~EEex is not installed.~

// This component is deliberately independent of component 0. M_ files autoload through EEex,
// so it only needs to place its own observer in override.
MKDIR ~bgse-playtest~
COPY ~bgse/lua/M_BGSERC.lua~ ~override~
