// Designed encounters (docs/research/BOSS-01-bg1-early-encounters.md: Christopher designs each fight,
// SCS is the blueprint, credit DavidW): what a fight's design changes in its creatures, one entry each in
// bgse/encounters.tpa. The engine's side of the same design is combat-intent/encounters.lua.
//
// bgse_encounter changes one creature file (cre, without .cre), and only what its entry names:
// - ability scores (str, int, wis, dex, con, cha): set exactly as named;
// - book: the memorized spells of each spell level it names, as ~priest1=SPPR111,SPPR117 priest2=SPPR201~
//   (priest or wizard, and the spell level): those of that level go and these come, each as often as it
//   is named and known once; other levels, kinds and the innate abilities stay;
// - carries: items it gets in a free pack slot, or in the last pack slot when full, unless it carries one
//   already, as ~POTN10~;
// - talk: its own copy of a talk script many creatures share, as ~INITDLG>BGSEKARL~ (the script in its
//   slots, and the copy's name): the copy's talk on sight waits while the engine prepares the creature
//   (bgse/lib/hook.tpa: bgse_talk_bcs), as SCS's talk-on-sight scripts do, and the creature's slot names the
//   copy, so no other creature's talk changes;
// - cutscene and prepare: in that cutscene, before the creature's first wait in its block, it drinks each
//   item of prepare (given first when needed) and casts each spell of prepare, the slot spent
//   (bgse_encounter_cutscene).
// A spell or item this game lacks is left out with one log line; the rest of the entry still applies, and a
// book level none of whose spells this game has stays as it is. A talk uses the first empty script slot when
// the source is absent from its slots, or the override slot when none is empty; a source without a talk on
// sight stays a dead end. A creature file that is missing or no CRE V1.0 file is left out.
// bgse_changed is 1 when the creature or its cutscene changed.
DEFINE_ACTION_FUNCTION bgse_encounter
  INT_VAR str = 0
          int = 0
          wis = 0
          dex = 0
          con = 0
          cha = 0
  STR_VAR cre = ~~
          book = ~~
          carries = ~~
          talk = ~~
          cutscene = ~~
          prepare = ~~
  RET bgse_changed
BEGIN
  OUTER_SET bgse_changed = 0
  ACTION_IF (STRING_LENGTH ~%cre%~ > 0) AND (FILE_EXISTS_IN_GAME ~%cre%.cre~) BEGIN
    COPY_EXISTING ~%cre%.cre~ ~override~
      SET bgse_changed = 0
      TEXT_SPRINT signature ~~
      PATCH_IF (BUFFER_LENGTH >= 0x2d4) BEGIN
        READ_ASCII 0 signature (8)
      END
      PATCH_IF (~%signature%~ STRING_EQUAL ~CRE V1.0~) BEGIN
        LPF bgse_encounter_scores INT_VAR str = str int = int wis = wis dex = dex con = con cha = cha RET bgse_scored END
        LPF bgse_encounter_book STR_VAR cre = EVAL ~%cre%~ book = EVAL ~%book%~ RET bgse_booked END
        LPF bgse_encounter_carries STR_VAR cre = EVAL ~%cre%~ carries = EVAL ~%carries%~ RET bgse_given END
        SET bgse_carried = bgse_given
        LPF bgse_encounter_talk STR_VAR cre = EVAL ~%cre%~ talk = EVAL ~%talk%~ RET bgse_talked END
        LPF bgse_encounter_cutscene STR_VAR cre = EVAL ~%cre%~ cutscene = EVAL ~%cutscene%~ prepare = EVAL ~%prepare%~
          RET bgse_prepared END
        SET bgse_changed = (bgse_scored + bgse_booked + bgse_carried + bgse_talked + bgse_prepared > 0) ? 1 : 0
      END ELSE BEGIN
        PATCH_PRINT ~BGSE encounter: %cre%.cre is no CRE V1.0 file, left as it is~
      END
    BUT_ONLY_IF_IT_CHANGES
  END ELSE BEGIN
    PRINT ~BGSE encounter: %cre%.cre is not in this game, left out~
  END
END

// The ability scores of bgse_encounter: each named score is written exactly. bgse_scored counts the scores
// that changed.
DEFINE_PATCH_FUNCTION bgse_encounter_scores
  INT_VAR str = 0
          int = 0
          wis = 0
          dex = 0
          con = 0
          cha = 0
  RET bgse_scored
BEGIN
  SET bgse_scored = 0
  // 0x239 is the exceptional strength, which no score names.
  FOR (o = 0x238; o <= 0x23e; o += 1) BEGIN
    SET score = 0
    PATCH_IF (o = 0x238) BEGIN SET score = str END
    PATCH_IF (o = 0x23a) BEGIN SET score = int END
    PATCH_IF (o = 0x23b) BEGIN SET score = wis END
    PATCH_IF (o = 0x23c) BEGIN SET score = dex END
    PATCH_IF (o = 0x23d) BEGIN SET score = con END
    PATCH_IF (o = 0x23e) BEGIN SET score = cha END
    PATCH_IF (score > 0) AND (score <= 25) AND (BYTE_AT o != score) BEGIN
      WRITE_BYTE o score
      SET bgse_scored += 1
    END
  END
END

// The book of bgse_encounter, level by level. bgse_booked counts the levels whose memorized spells changed.
DEFINE_PATCH_FUNCTION bgse_encounter_book
  STR_VAR cre = ~~
          book = ~~
  RET bgse_booked
BEGIN
  SET bgse_booked = 0
  TEXT_SPRINT levels ~~
  INNER_PATCH ~%book%~ BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE ~\(priest\|wizard\)\([1-9]\)=\([A-Za-z0-9_#,-]+\)~ BEGIN
      TEXT_SPRINT kind ~%MATCH1%~
      TO_LOWER kind
      TEXT_SPRINT levels ~%levels%%kind%:%MATCH2%:%MATCH3%|~
    END ~%MATCH0%~
  END
  SET pos = 0
  WHILE (pos < STRING_LENGTH ~%levels%~) BEGIN
    INNER_PATCH ~%levels%~ BEGIN
      SET to = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~|~ pos)
      READ_ASCII pos entry (to - pos)
    END
    SET pos = to + 1
    INNER_PATCH ~%entry%~ BEGIN
      REPLACE_EVALUATE CASE_SENSITIVE ~^\([a-z]+\):\([1-9]\):\(.*\)$~ BEGIN
        TEXT_SPRINT kind ~%MATCH1%~
        SET level = MATCH2
        TEXT_SPRINT list ~%MATCH3%,~
      END ~%MATCH0%~
    END
    LPF bgse_encounter_level INT_VAR level = level STR_VAR cre = EVAL ~%cre%~ kind = EVAL ~%kind%~ list = EVAL ~%list%~
      RET bgse_changed_level END
    SET bgse_booked += bgse_changed_level
  END
END

// One level of a book (bgse_encounter_book): kind priest or wizard, the spell level, and list, its spells
// each followed by a comma. bgse_changed_level is 1 when that level's memorized spells changed.
DEFINE_PATCH_FUNCTION bgse_encounter_level
  INT_VAR level = 1
  STR_VAR cre = ~~
          kind = ~priest~
          list = ~~
  RET bgse_changed_level
BEGIN
  SET bgse_changed_level = 0
  SET type = (~%kind%~ STRING_EQUAL ~wizard~) ? 1 : 0
  SET row = level - 1
  // The spells this game has, in the book's order. The book decides their kind and level.
  TEXT_SPRINT wanted ~|~
  SET pos = 0
  WHILE (pos < STRING_LENGTH ~%list%~) BEGIN
    INNER_PATCH ~%list%~ BEGIN
      SET to = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~,~ pos)
      READ_ASCII pos spell (to - pos)
    END
    SET pos = to + 1
    TO_UPPER spell
    SET exists = 0
    PATCH_IF (STRING_LENGTH ~%spell%~ > 0) AND (STRING_LENGTH ~%spell%~ <= 8) BEGIN
      PATCH_IF (FILE_EXISTS_IN_GAME ~%spell%.spl~) BEGIN
        SET exists = 1
      END
    END
    PATCH_IF (exists = 1) BEGIN
      TEXT_SPRINT wanted ~%wanted%%spell%|~
    END ELSE PATCH_IF (STRING_LENGTH ~%spell%~ > 0) BEGIN
      PATCH_PRINT ~BGSE encounter: %cre%.cre leaves out %spell% (%kind% level %level%): this game lacks it~
    END
  END
  PATCH_IF (STRING_LENGTH ~%wanted%~ > 1) BEGIN
    // What the level holds now: its memorized spells, each once.
    TEXT_SPRINT had ~|~
    READ_LONG 0x2a8 info
    READ_LONG 0x2ac info_count
    READ_LONG 0x2b0 at
    READ_LONG 0x2b4 count
    FOR (i = 0; i < info_count; i += 1) BEGIN
      PATCH_IF (info + 16 * i + 16 <= BUFFER_LENGTH) BEGIN
        READ_SHORT (info + 16 * i) row_level
        READ_SHORT (info + 16 * i + 6) row_type
        READ_LONG (info + 16 * i + 8) first
        READ_LONG (info + 16 * i + 12) many
        PATCH_IF (row_level = level - 1) AND (row_type = type) BEGIN
          FOR (j = first; (j < first + many) AND (j < count); j += 1) BEGIN
            PATCH_IF (at + 12 * j + 12 <= BUFFER_LENGTH) BEGIN
              READ_ASCII (at + 12 * j) spell (8) NULL
              TO_UPPER spell
              PATCH_IF (STRING_LENGTH ~%spell%~ > 0) AND (INDEX (CASE_SENSITIVE EXACT_MATCH ~|%spell%|~ ~%had%~) < 0) BEGIN
                TEXT_SPRINT had ~%had%%spell%|~
              END
            END
          END
        END
      END
    END
    READ_ASCII 0 cre_bytes (BUFFER_LENGTH)
    PATCH_TRY
        // The level's spells go; those the book leaves out are forgotten too.
        SET p = 1
        WHILE (p < STRING_LENGTH ~%had%~) BEGIN
          INNER_PATCH ~%had%~ BEGIN
            SET to = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~|~ p)
            READ_ASCII p spell (to - p)
          END
          SET p = to + 1
          REMOVE_MEMORIZED_SPELL ~%spell%~
          PATCH_IF (INDEX (CASE_SENSITIVE EXACT_MATCH ~|%spell%|~ ~%wanted%~) < 0) BEGIN
            REMOVE_KNOWN_SPELL ~%spell%~
          END
        END
        // The book's spells come, each known once.
        SET p = 1
        WHILE (p < STRING_LENGTH ~%wanted%~) BEGIN
          INNER_PATCH ~%wanted%~ BEGIN
            SET to = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~|~ p)
            READ_ASCII p spell (to - p)
          END
          SET p = to + 1
          SET known = 0
          READ_LONG 0x2a0 known_at
          READ_LONG 0x2a4 known_count
          FOR (k = 0; k < known_count; k += 1) BEGIN
            PATCH_IF (known_at + 12 * k + 12 <= BUFFER_LENGTH) BEGIN
              READ_ASCII (known_at + 12 * k) name (8) NULL
              READ_SHORT (known_at + 12 * k + 8) known_level
              READ_SHORT (known_at + 12 * k + 10) known_type
              PATCH_IF (~%name%~ STRING_EQUAL_CASE ~%spell%~) AND (known_level = level - 1) AND (known_type = type) BEGIN
                SET known = 1
              END
            END
          END
          PATCH_IF (known = 0) BEGIN
            ADD_KNOWN_SPELL ~%spell%~ (row) ~%kind%~
          END
          ADD_MEMORIZED_SPELL ~%spell%~ (row) ~%kind%~ (1)
        END
        SET bgse_changed_level = 1
      WITH DEFAULT
        SET bgse_changed_level = 0
        DELETE_BYTES 0 BUFFER_LENGTH
        INSERT_BYTES 0 (STRING_LENGTH ~%cre_bytes%~)
        WRITE_ASCIIE 0 ~%cre_bytes%~
        PATCH_PRINT ~BGSE encounter: %cre%.cre keeps its %kind% level %level% spells (WeiDU could not change them)~
      END
  END ELSE BEGIN
    PATCH_PRINT ~BGSE encounter: %cre%.cre keeps its %kind% level %level% spells: this game has none of the book's~
  END
END

// The talk of bgse_encounter (talk, ~SOURCE>COPY~): the copy of SOURCE, its talk on sight held as SCS's are,
// named COPY in the first of the creature's script slots that names SOURCE, else the first empty slot or the
// override slot. bgse_talked is 1 when the slot changed.
DEFINE_PATCH_FUNCTION bgse_encounter_talk
  STR_VAR cre = ~~
          talk = ~~
  RET bgse_talked
BEGIN
  SET bgse_talked = 0
  PATCH_IF (STRING_LENGTH ~%talk%~ > 0) BEGIN
    TEXT_SPRINT source ~~
    TEXT_SPRINT copy ~~
    INNER_PATCH ~%talk%~ BEGIN
      REPLACE_EVALUATE CASE_INSENSITIVE ~^\([A-Za-z0-9_#-]+\)>\([A-Za-z0-9_#-]+\)$~ BEGIN
        TEXT_SPRINT source ~%MATCH1%~
        TEXT_SPRINT copy ~%MATCH2%~
      END ~%MATCH0%~
    END
    TO_UPPER source
    TO_UPPER copy
    SET slot = 0 - 1
    SET empty = 0 - 1
    FOR (o = 0x248; o < 0x270; o += 8) BEGIN
      READ_ASCII o script (8) NULL
      PATCH_IF (slot < 0) AND (STRING_LENGTH ~%source%~ > 0) AND (~%script%~ STRING_EQUAL_CASE ~%source%~) BEGIN
        SET slot = o
      END
      PATCH_IF (empty < 0) AND (STRING_LENGTH ~%script%~ = 0) BEGIN
        SET empty = o
      END
    END
    SET has_source = 0
    PATCH_IF (STRING_LENGTH ~%source%~ > 0) AND (STRING_LENGTH ~%source%~ <= 8) AND (STRING_LENGTH ~%copy%~ > 0)
        AND (STRING_LENGTH ~%copy%~ <= 8) BEGIN
      PATCH_IF (FILE_EXISTS_IN_GAME ~%source%.bcs~) BEGIN
        SET has_source = 1
      END
    END
    PATCH_IF (STRING_LENGTH ~%source%~ = 0) OR (STRING_LENGTH ~%source%~ > 8) OR (STRING_LENGTH ~%copy%~ > 8) BEGIN
      PATCH_PRINT ~BGSE encounter: %cre%.cre: "%talk%" names no script and copy, its talk stays as it is~
    END ELSE PATCH_IF (has_source = 0) BEGIN
      PATCH_PRINT ~BGSE encounter: %cre%.cre keeps %source%: this game lacks %source%.bcs~
    END ELSE BEGIN
      PATCH_IF (slot < 0) BEGIN
        SET slot = (empty >= 0) ? empty : 0x248
      END
      TEXT_SPRINT name ~%copy%~
      TO_LOWER name
      SET bgse_talks = 0
      INNER_ACTION BEGIN
        COPY_EXISTING ~%source%.bcs~ ~override/%copy%.bcs~
          LPF bgse_talk_bcs INT_VAR bgse_own = 1 STR_VAR bgse_script = EVAL ~%name%~ RET bgse_talks END
        BUT_ONLY_IF_IT_CHANGES
      END
      PATCH_IF (bgse_talks > 0) BEGIN
        WRITE_ASCIIE slot ~%copy%~ #8
        SET bgse_talked = 1
      END ELSE BEGIN
        PATCH_PRINT ~BGSE encounter: %cre%.cre keeps %source%: it has no talk on sight~
      END
    END
  END
END

// The preparation of bgse_encounter in a cutscene (Christopher, 2026-11-04, for Silke: she plans the ambush
// herself, so she is ready, and the party sees a real caster first): in the cutscene script's block for the
// creature (CutSceneId with its script name), before the block's first wait, it drinks each item of prepare
// (giving it first when it lacks it) and casts each spell of prepare at itself (ForceSpellRES, with its casting,
// then RemoveSpellRES, so the slot is spent), in the order prepare names them. A cutscene that runs
// without triggers cannot ask for the difficulty, so this holds on every difficulty. bgse_prepared is 1 when
// the cutscene changed.
DEFINE_PATCH_FUNCTION bgse_encounter_cutscene
  STR_VAR cre = ~~
          cutscene = ~~
          prepare = ~~
  RET bgse_prepared
BEGIN
  SET bgse_prepared = 0
  PATCH_IF (STRING_LENGTH ~%cutscene%~ > 0) AND (STRING_LENGTH ~%prepare%~ > 0) BEGIN
    READ_ASCII 0x280 who (32) NULL
    TEXT_SPRINT actions ~~
    TEXT_SPRINT wanted ~~
    INNER_PATCH ~%prepare%~ BEGIN
      REPLACE_EVALUATE CASE_INSENSITIVE ~[A-Za-z0-9_#-]+~ BEGIN
        TEXT_SPRINT wanted ~%wanted%%MATCH0%|~
      END ~%MATCH0%~
    END
    SET pos = 0
    WHILE (pos < STRING_LENGTH ~%wanted%~) BEGIN
      INNER_PATCH ~%wanted%~ BEGIN
        SET to = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~|~ pos)
        READ_ASCII pos res (to - pos)
      END
      SET pos = to + 1
      TO_UPPER res
      PATCH_IF (FILE_EXISTS_IN_GAME ~%res%.itm~) BEGIN
        LPF bgse_encounter_carries STR_VAR cre = EVAL ~%cre%~ carries = EVAL ~%res%~ RET bgse_given END
        SET bgse_prepared += bgse_given
        TEXT_SPRINT actions ~%actions%    UseItem("%res%",Myself)%LNL%~
      END ELSE PATCH_IF (FILE_EXISTS_IN_GAME ~%res%.spl~) BEGIN
        TEXT_SPRINT actions ~%actions%    ForceSpellRES("%res%",Myself)%LNL%    RemoveSpellRES("%res%")%LNL%~
      END ELSE BEGIN
        PATCH_PRINT ~BGSE encounter: %cre%.cre does not prepare %res% in %cutscene%: this game lacks its .itm and .spl files~
      END
    END
    PATCH_IF (STRING_LENGTH ~%actions%~ > 0) AND (STRING_LENGTH ~%who%~ > 0) BEGIN
      PATCH_IF (FILE_EXISTS_IN_GAME ~%cutscene%.bcs~) BEGIN
        SET bgse_cut = 0
        INNER_ACTION BEGIN
          COPY_EXISTING ~%cutscene%.bcs~ ~override~
            LPF bgse_cut_prep_bcs STR_VAR who = EVAL ~%who%~ actions = EVAL ~%actions%~ RET bgse_cut END
          BUT_ONLY_IF_IT_CHANGES
        END
        SET bgse_prepared = (bgse_prepared + bgse_cut > 0) ? 1 : 0
        PATCH_IF (bgse_cut = 0) BEGIN
          PATCH_PRINT ~BGSE encounter: %cutscene% has no block for %who%, so %cre%.cre does not prepare there~
        END
      END ELSE BEGIN
        PATCH_PRINT ~BGSE encounter: this game lacks %cutscene%.bcs, so %cre%.cre does not prepare there~
      END
    END
  END
END

// Lines (actions, one an indented line each) before the first action named before (a Wait by default) in the block
// of the cutscene in the patch buffer whose response names who in CutSceneId, or after that CutSceneId line in a
// block without such an action. A script that fails to decompile, patch or compile, or has no such block, is left
// exactly as it was (bgse_cut 0).
DEFINE_PATCH_FUNCTION bgse_cut_prep_bcs
  STR_VAR who = ~~
          actions = ~~
          before = ~Wait(~
  RET bgse_cut
BEGIN
  SET bgse_cut = 0
  READ_ASCII 0 bcs (BUFFER_LENGTH)
  PATCH_TRY
    INNER_PATCH_SAVE baf ~%bcs%~ BEGIN
      DECOMPILE_BCS_TO_BAF
    END
    INNER_PATCH_SAVE baf ~%baf%~ BEGIN
      PATCH_IF (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%MNL%~) >= 0) BEGIN
        REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~%MNL%~ ~~
      END
      SET at = INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~CutSceneId("%who%")~)
      PATCH_IF (at >= 0) BEGIN
        SET end = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%LNL%END%LNL%~ at)
        SET wait = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%LNL%    %before%~ at)
        PATCH_IF (end >= 0) BEGIN
          PATCH_IF (wait >= 0) AND (wait < end) BEGIN
            SET into = wait + STRING_LENGTH ~%LNL%~
          END ELSE BEGIN
            SET into = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%LNL%~ at) + 1
          END
          INSERT_BYTES into (STRING_LENGTH ~%actions%~)
          WRITE_ASCIIE into ~%actions%~
          SET bgse_cut = 1
        END
      END
    END
    PATCH_IF (bgse_cut = 1) BEGIN
      DELETE_BYTES 0 BUFFER_LENGTH
      INSERT_BYTES 0 (STRING_LENGTH ~%baf%~)
      WRITE_ASCIIE 0 ~%baf%~
      COMPILE_BAF_TO_BCS
    END
  WITH DEFAULT
    SET bgse_cut = 0
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 (STRING_LENGTH ~%bcs%~)
    WRITE_ASCIIE 0 ~%bcs%~
  END
END

// A line of the engine's in a cutscene (line, an action; such as ~EEex_LuaAction("...")~): in the block for who
// (CutSceneId), before its first action named before. bgse_put is 1 when the cutscene changed.
DEFINE_ACTION_FUNCTION bgse_encounter_cutline
  STR_VAR cutscene = ~~
          who = ~~
          before = ~~
          line = ~~
  RET bgse_put
BEGIN
  OUTER_SET bgse_put = 0
  ACTION_IF (STRING_LENGTH ~%cutscene%~ > 0) AND (FILE_EXISTS_IN_GAME ~%cutscene%.bcs~) BEGIN
    OUTER_TEXT_SPRINT actions ~    %line%%LNL%~
    OUTER_SET bgse_cut = 0
    COPY_EXISTING ~%cutscene%.bcs~ ~override~
      LPF bgse_cut_prep_bcs STR_VAR who = EVAL ~%who%~ actions = EVAL ~%actions%~ before = EVAL ~%before%~
        RET bgse_cut END
    BUT_ONLY_IF_IT_CHANGES
    OUTER_SET bgse_put = bgse_cut
    ACTION_IF (bgse_put = 0) BEGIN
      PRINT ~BGSE encounter: %cutscene% has no block for %who%, its line is left out~
    END
  END ELSE BEGIN
    PRINT ~BGSE encounter: this game lacks %cutscene%.bcs, its line is left out~
  END
END

// A new creature a designed encounter brings (Christopher designs each one; Kestrel, Greywolf's archer,
// 2026-11-04): a copy of chassis, a creature of the game that gives it its body, voice and own effects, set as
// the entry says. Its name (a new string), level, hit points, THAC0, and the ability scores given (above 0);
// the saving throws of its class at its level, from the game's table for the class (SAVEWAR.2DA for warriors,
// SAVEWIZ, SAVEPRS, SAVEROG, SAVEMONK; a multiclass chassis keeps its own); neutral and of alignment
// (ALIGNMEN.IDS); its own script in the override slot and, as its default script, the
// first of default this game has; no dialog; death variable dv; only the items of items, as
// ~SLOT:RESREF[:charges]~ entries (armor, shield and weapons equipped); and, when profs names them, only these
// weapon proficiencies, as ~PROFICIENCY:stars~ entries (WEAPPROF.IDS numbers, such as ~105:2~ for two stars in
// the short bow), in place of the chassis's own. A chassis or item this game lacks is left out with a warning.
// bgse_born is 1 when the creature was made.
DEFINE_ACTION_FUNCTION bgse_encounter_new
  INT_VAR level = 1
          hp = 1
          thac0 = 20
          str = 0
          int = 0
          wis = 0
          dex = 0
          con = 0
          cha = 0
          alignment = 0x22
  STR_VAR chassis = ~~
          cre = ~~
          name = ~~
          script = ~~
          default = ~~
          dv = ~~
          items = ~~
          profs = ~~
  RET bgse_born
BEGIN
  OUTER_SET bgse_born = 0
  OUTER_TEXT_SPRINT fight ~~
  OUTER_PATCH ~%default%~ BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE ~[A-Za-z0-9_#-]+~ BEGIN
      PATCH_IF (STRING_LENGTH ~%fight%~ = 0) AND (FILE_EXISTS_IN_GAME ~%MATCH0%.bcs~) BEGIN
        TEXT_SPRINT fight ~%MATCH0%~
      END
    END ~%MATCH0%~
  END
  ACTION_IF NOT (FILE_EXISTS_IN_GAME ~%chassis%.cre~) BEGIN
    PRINT ~BGSE encounter: this game lacks %chassis%.cre, so %cre%.cre is not made~
  END ELSE BEGIN
    COPY_EXISTING ~%chassis%.cre~ ~override/%cre%.cre~
      SAY_EVALUATED 0x08 ~%name%~
      SAY_EVALUATED 0x0c ~%name%~
      WRITE_SHORT 0x24 hp
      WRITE_SHORT 0x26 hp
      WRITE_BYTE 0x52 thac0
      WRITE_BYTE 0x234 level
      // Its saving throws are those of its class at its level, from the game's own table for the class, so that
      // it inherits no chassis's better or worse ones.
      READ_BYTE 0x273 class
      TEXT_SPRINT table ~~
      PATCH_MATCH class WITH
        2 6 12 BEGIN TEXT_SPRINT table ~savewar~ END
        1 19 BEGIN TEXT_SPRINT table ~savewiz~ END
        3 11 21 BEGIN TEXT_SPRINT table ~saveprs~ END
        4 5 BEGIN TEXT_SPRINT table ~saverog~ END
        20 BEGIN TEXT_SPRINT table ~savemonk~ END
        DEFAULT
      END
      SET saves = 0
      PATCH_IF (STRING_LENGTH ~%table%~ > 0) AND (FILE_EXISTS_IN_GAME ~%table%.2da~) BEGIN
        INNER_PATCH_FILE ~%table%.2da~ BEGIN
          // Only rows that reach the level's column; the column of level 1 follows the row's name.
          READ_2DA_ENTRIES_NOW bgse_save_rows (level + 1)
          FOR (r = 0; r < bgse_save_rows; r += 1) BEGIN
            READ_2DA_ENTRY_FORMER bgse_save_rows r 0 save_row
            READ_2DA_ENTRY_FORMER bgse_save_rows r level save_value
            PATCH_IF (IS_AN_INT ~%save_value%~) BEGIN
              PATCH_IF (~%save_row%~ STRING_EQUAL_CASE ~DEATH~) BEGIN
                SET save_death = save_value
                SET saves = saves BOR 1
              END
              PATCH_IF (~%save_row%~ STRING_EQUAL_CASE ~WANDS~) BEGIN
                SET save_wands = save_value
                SET saves = saves BOR 2
              END
              PATCH_IF (~%save_row%~ STRING_EQUAL_CASE ~POLY~) BEGIN
                SET save_poly = save_value
                SET saves = saves BOR 4
              END
              PATCH_IF (~%save_row%~ STRING_EQUAL_CASE ~BREATH~) BEGIN
                SET save_breath = save_value
                SET saves = saves BOR 8
              END
              PATCH_IF (~%save_row%~ STRING_EQUAL_CASE ~SPELL~) BEGIN
                SET save_spell = save_value
                SET saves = saves BOR 16
              END
            END
          END
        END
      END
      PATCH_IF (saves = 31) BEGIN
        WRITE_BYTE 0x54 save_death
        WRITE_BYTE 0x55 save_wands
        WRITE_BYTE 0x56 save_poly
        WRITE_BYTE 0x57 save_breath
        WRITE_BYTE 0x58 save_spell
      END ELSE BEGIN
        PATCH_PRINT ~BGSE encounter: %cre%.cre keeps the saving throws of %chassis%.cre: this game has no table for its class at level %level%~
      END
      FOR (o = 0x238; o <= 0x23e; o += 1) BEGIN
        SET v = 0
        PATCH_IF (o = 0x238) BEGIN SET v = str END
        PATCH_IF (o = 0x23a) BEGIN SET v = int END
        PATCH_IF (o = 0x23b) BEGIN SET v = wis END
        PATCH_IF (o = 0x23c) BEGIN SET v = dex END
        PATCH_IF (o = 0x23d) BEGIN SET v = con END
        PATCH_IF (o = 0x23e) BEGIN SET v = cha END
        PATCH_IF (v > 0) AND (v <= 25) BEGIN
          WRITE_BYTE o v
        END
      END
      WRITE_BYTE 0x270 128
      WRITE_BYTE 0x27b alignment
      WRITE_ASCIIE 0x248 ~%script%~ #8
      WRITE_ASCII 0x250 ~~ #8
      WRITE_ASCII 0x258 ~~ #8
      WRITE_ASCII 0x260 ~~ #8
      WRITE_ASCIIE 0x268 ~%fight%~ #8
      WRITE_ASCIIE 0x280 ~%dv%~ #32
      WRITE_ASCII 0x2cc ~~ #8
      REMOVE_CRE_ITEMS
      INNER_PATCH_SAVE list ~%items%~ BEGIN
        REPLACE_TEXTUALLY ~[ %TAB%%LNL%%MNL%]+~ ~|~
      END
      TEXT_SPRINT list ~|%list%|~
      SET pos = 1
      WHILE (pos < STRING_LENGTH ~%list%~) BEGIN
        INNER_PATCH ~%list%~ BEGIN
          SET to = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~|~ pos)
          READ_ASCII pos entry (to - pos)
        END
        SET pos = to + 1
        TEXT_SPRINT slot ~~
        TEXT_SPRINT res ~~
        SET charges = 0
        TEXT_SPRINT rest ~~
        INNER_PATCH ~%entry%~ BEGIN
          REPLACE_EVALUATE CASE_INSENSITIVE ~^\([A-Z0-9]+\):\([A-Za-z0-9_#-]+\)\(.*\)$~ BEGIN
            TEXT_SPRINT slot ~%MATCH1%~
            TEXT_SPRINT res ~%MATCH2%~
            TEXT_SPRINT rest ~%MATCH3%~
          END ~%MATCH0%~
        END
        // The charges, when the entry gives them (~QUIVER1:AROW01:40~).
        INNER_PATCH ~%rest%~ BEGIN
          REPLACE_EVALUATE ~^:\([0-9]+\)$~ BEGIN
            SET charges = MATCH1
          END ~%MATCH0%~
        END
        TO_UPPER slot
        PATCH_IF (STRING_LENGTH ~%res%~ > 0) BEGIN
          PATCH_IF NOT (FILE_EXISTS_IN_GAME ~%res%.itm~) BEGIN
            PATCH_PRINT ~BGSE encounter: %cre%.cre does not get %res%: this game lacks it~
          END ELSE PATCH_IF (~%slot%~ STRING_EQUAL ~ARMOR~) OR (~%slot%~ STRING_EQUAL ~SHIELD~)
              OR (~%slot%~ STRING_EQUAL ~WEAPON1~) BEGIN
            ADD_CRE_ITEM ~%res%~ (charges) #0 #0 ~IDENTIFIED~ ~%slot%~ EQUIP
          END ELSE BEGIN
            ADD_CRE_ITEM ~%res%~ (charges) #0 #0 ~IDENTIFIED~ ~%slot%~
          END
        END
      END
      // Its weapon proficiencies (opcode 233, permanent, on itself) in place of the chassis's.
      PATCH_IF (STRING_LENGTH ~%profs%~ > 0) BEGIN
        LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete = 233 END
        INNER_PATCH_SAVE plist ~%profs%~ BEGIN
          REPLACE_TEXTUALLY ~[ %TAB%%LNL%%MNL%]+~ ~|~
        END
        TEXT_SPRINT plist ~|%plist%|~
        SET pos = 1
        WHILE (pos < STRING_LENGTH ~%plist%~) BEGIN
          INNER_PATCH ~%plist%~ BEGIN
            SET to = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~|~ pos)
            READ_ASCII pos entry (to - pos)
          END
          SET pos = to + 1
          SET prof = 0
          SET stars = 0
          INNER_PATCH ~%entry%~ BEGIN
            REPLACE_EVALUATE ~^\([0-9]+\):\([0-9]+\)$~ BEGIN
              SET prof = MATCH1
              SET stars = MATCH2
            END ~%MATCH0%~
          END
          PATCH_IF (prof > 0) AND (stars > 0) BEGIN
            LPF ADD_CRE_EFFECT INT_VAR opcode = 233 target = 1 timing = 9 parameter1 = stars parameter2 = prof END
          END
        END
      END
    BUT_ONLY_IF_IT_CHANGES
    OUTER_SET bgse_born = 1
  END
END

// A line a designed encounter adds to a dialogue (Christopher writes or approves each one): line, said in a new
// state named state, which follows the state of dialogue dlg whose transition does after (the text of an action
// there, such as ~StartCutSceneEx("Garrcut"~) and takes that transition over. The state is found by what it does,
// not by its number; when more than one state does it, the first takes the line. A dialogue with no state is
// left as it is, with a warning.
// bgse_said is 1 when the line went in.
DEFINE_ACTION_FUNCTION bgse_encounter_line
  STR_VAR dlg = ~~
          after = ~~
          state = ~~
          line = ~~
  RET bgse_said
BEGIN
  OUTER_SET bgse_said = 0
  OUTER_SET bgse_line_from = 0 - 1
  OUTER_SET bgse_line_trans = 0 - 1
  OUTER_SET bgse_line_hits = 0
  OUTER_SET bgse_line_new = 0
  ACTION_IF (STRING_LENGTH ~%dlg%~ > 0) AND (FILE_EXISTS_IN_GAME ~%dlg%.dlg~) BEGIN
    COPY_EXISTING ~%dlg%.dlg~ ~override~
      READ_ASCII 0 dlg_bytes (BUFFER_LENGTH)
      INNER_PATCH_SAVE text ~%dlg_bytes%~ BEGIN
        DECOMPILE_DLG_TO_D
      END
      INNER_PATCH ~%text%~ BEGIN
        // The new state comes after the last: its number is the count of states.
        SET p = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~THEN BEGIN ~)
        WHILE (p >= 0) BEGIN
          SET bgse_line_new += 1
          SET p = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~THEN BEGIN ~ (p + 1))
        END
        SET hit = INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~%after%~)
        WHILE (hit >= 0) BEGIN
          SET bgse_line_hits += 1
          PATCH_IF (bgse_line_hits = 1) BEGIN
            // The state: the last "THEN BEGIN n" before the hit; the transition: how many transitions of
            // that state begin before the hit, less one.
            SET begin = 0 - 1
            SET p = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~THEN BEGIN ~)
            WHILE (p >= 0) AND (p < hit) BEGIN
              SET begin = p
              SET p = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~THEN BEGIN ~ (p + 1))
            END
            PATCH_IF (begin >= 0) BEGIN
              SET from = begin + STRING_LENGTH ~THEN BEGIN ~
              SET stop = INDEX_BUFFER (CASE_SENSITIVE ~[^0-9]~ from)
              READ_ASCII from number (stop - from)
              SET bgse_line_from = number
              SET bgse_line_trans = 0 - 1
              SET p = INDEX_BUFFER (CASE_SENSITIVE ~^  IF ~ begin)
              WHILE (p >= 0) AND (p < hit) BEGIN
                SET bgse_line_trans += 1
                SET p = INDEX_BUFFER (CASE_SENSITIVE ~^  IF ~ (p + 1))
              END
            END
          END
          SET hit = INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~%after%~ (hit + 1))
        END
      END
    BUT_ONLY_IF_IT_CHANGES
    ACTION_IF (bgse_line_hits > 0) AND (bgse_line_from >= 0) AND (bgse_line_trans >= 0) BEGIN
      OUTER_TEXT_SPRINT bgse_line_dlg ~%dlg%~
      OUTER_TEXT_SPRINT bgse_line_state ~%state%~
      OUTER_TEXT_SPRINT bgse_line_text ~%line%~
      COMPILE EVALUATE_BUFFER ~.../bgse-inline/bgse-line-add.d~
      COMPILE EVALUATE_BUFFER ~.../bgse-inline/bgse-line-alter.d~
      OUTER_SET bgse_said = 1
    END ELSE BEGIN
      PRINT ~BGSE encounter: %dlg%.dlg has %bgse_line_hits% states that do %after%, so its line is left out~
    END
  END ELSE BEGIN
    PRINT ~BGSE encounter: %dlg%.dlg is not in this game, its line is left out~
  END
END

// The two steps of bgse_encounter_line, compiled one after the other, so that the new state copies the
// transitions as they were before the old state's transition points at it. A label lives only while its own
// file compiles, so the second step names the new state by its number (bgse_line_new).
<<<<<<<< .../bgse-inline/bgse-line-add.d
APPEND ~%bgse_line_dlg%~
  IF ~~ THEN BEGIN %bgse_line_state%
    SAY ~%bgse_line_text%~
    COPY_TRANS ~%bgse_line_dlg%~ %bgse_line_from%
  END
END
>>>>>>>>
<<<<<<<< .../bgse-inline/bgse-line-alter.d
ALTER_TRANS ~%bgse_line_dlg%~ BEGIN %bgse_line_from% END BEGIN %bgse_line_trans% END BEGIN
  "EPILOGUE" ~GOTO %bgse_line_new%~
  "ACTION" ~~
END
>>>>>>>>

// The items of bgse_encounter: each it does not carry yet, in a free pack slot, or in the last pack slot when
// full. bgse_given counts them.
DEFINE_PATCH_FUNCTION bgse_encounter_carries
  STR_VAR cre = ~~
          carries = ~~
  RET bgse_given
BEGIN
  SET bgse_given = 0
  TEXT_SPRINT items ~~
  INNER_PATCH ~%carries%~ BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE ~[A-Za-z0-9_#-]+~ BEGIN
      TEXT_SPRINT items ~%items%%MATCH0%|~
    END ~%MATCH0%~
  END
  SET pos = 0
  WHILE (pos < STRING_LENGTH ~%items%~) BEGIN
    INNER_PATCH ~%items%~ BEGIN
      SET to = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~|~ pos)
      READ_ASCII pos item (to - pos)
    END
    SET pos = to + 1
    TO_UPPER item
    SET carried = 0
    READ_LONG 0x2bc item_at
    READ_LONG 0x2c0 item_count
    FOR (i = 0; i < item_count; i += 1) BEGIN
      PATCH_IF (item_at + 20 * i + 20 <= BUFFER_LENGTH) BEGIN
        READ_ASCII (item_at + 20 * i) name (8) NULL
        PATCH_IF (~%name%~ STRING_EQUAL_CASE ~%item%~) BEGIN
          SET carried = 1
        END
      END
    END
    // A free pack slot: the slot words of the inventory, 21 to 36, empty.
    SET free = 0
    READ_LONG 0x2b8 slots
    FOR (s = 21; s <= 36; s += 1) BEGIN
      PATCH_IF (slots + 2 * s + 2 <= BUFFER_LENGTH) BEGIN
        READ_SHORT (slots + 2 * s) word
        PATCH_IF (word = 0xffff) OR (word = 0 - 1) BEGIN
          SET free = 1
        END
      END
    END
    SET exists = 0
    PATCH_IF (STRING_LENGTH ~%item%~ <= 8) BEGIN
      PATCH_IF (FILE_EXISTS_IN_GAME ~%item%.itm~) BEGIN
        SET exists = 1
      END
    END
    PATCH_IF (carried = 0) AND (exists = 0) BEGIN
      PATCH_PRINT ~BGSE encounter: %cre%.cre does not get %item%: this game lacks it~
    END ELSE PATCH_IF (carried = 0) AND (free = 0) BEGIN
      // ADD_CRE_ITEM warns even when it is told to use INV16 on a full pack. Replace that slot's item
      // record directly, so the pack stays full and the decided item is where it belongs.
      SET last = 0 - 1
      PATCH_IF (slots + 2 * 36 + 2 <= BUFFER_LENGTH) BEGIN
        READ_SHORT (slots + 2 * 36) last
      END
      PATCH_IF (last >= 0) AND (last < item_count) AND (item_at + 20 * last + 20 <= BUFFER_LENGTH) BEGIN
        WRITE_ASCIIE (item_at + 20 * last) ~%item%~ #8
        WRITE_SHORT (item_at + 20 * last + 10) 0
        WRITE_SHORT (item_at + 20 * last + 12) 0
        WRITE_SHORT (item_at + 20 * last + 14) 0
        WRITE_LONG (item_at + 20 * last + 16) 0
        SET bgse_given += 1
      END ELSE BEGIN
        PATCH_PRINT ~BGSE encounter: %cre%.cre does not get %item%: its last pack slot is damaged~
      END
    END ELSE PATCH_IF (carried = 0) BEGIN
      ADD_CRE_ITEM ~%item%~ #0 #0 #0 ~NONE~ ~INV1 INV2 INV3 INV4 INV5 INV6 INV7 INV8 INV9 INV10 INV11 INV12 INV13 INV14 INV15 INV16~
      SET bgse_given += 1
    END
  END
END
