{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task 7 function-presence profile v1 (not runtime admission)",
  "$comment": "Shape only. The producer emits each known ID once in stable order. Presence never proves a compatible signature, lifecycle or native safety.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "runtimeVerified", "capabilities"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "function-presence"},
    "runtimeVerified": {"type": "boolean", "const": false},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["initialized", "session_destroyed", "sprite_loaded", "actor_lookup",
              "party_iteration", "area_iteration", "script_slots", "action_started",
              "action_queue", "sprite_persistence", "resource_lookup", "tick", "clock"]
          },
          "status": {"type": "string", "enum": ["present", "unavailable", "unresolved"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
